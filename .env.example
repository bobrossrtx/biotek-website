# Copy to .env.local and fill in. NEVER commit .env.local.

# The shared crew password for /admin
# Quoting rules: # starts a comment UNLESS the value is quoted. Quotes and
# spaces are safe inside quotes. Avoid a bare double-quote inside.
#   ADMIN_PASSWORD=plainpass123          -> fine
#   ADMIN_PASSWORD="my#pass with space"  -> fine (quotes stripped)
ADMIN_PASSWORD=change-me

# Random string used to sign the admin session cookie.
# Generate one: openssl rand -hex 32
ADMIN_SECRET=generate-a-random-hex-string

# Optional: where the SQLite DB + uploaded photos live (default: ./data)
# DATA_DIR=/var/lib/biotek-data

# --- Mail-out (admin console -> Mail tab) ---
# Resend (https://resend.com) — 3,000 emails/month free:
#   1. Create an API key at resend.com/api-keys
#   2. Verify your domain (or use onboarding@resend.dev for testing)
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx      (your API key)
#   MAIL_FROM=BioTek <noreply@yourdomain.co.uk>
#   SITE_URL=https://your-site.example
# For testing without a verified domain, MAIL_FROM must be onboarding@resend.dev

# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=
# MAIL_FROM=
# SITE_URL=
# CREW_EMAIL=crew@biotekcrew.party     (booking replies go here + replyTo on acknowledgements)
# BOOKINGS_FROM=BioTek Bookings <bookings@biotekcrew.party>   (From address on booking acknowledgement emails; defaults to CREW_EMAIL)
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx  (Svix signing secret from Resend -> Webhooks; verifies inbound reply webhooks)
